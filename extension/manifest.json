{
  "manifest_version": 3,
  "name": "LPU Internet Auto-Login",
  "version": "1.0.2",
  "description": "Automatically login to LPU internet portal",

  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },

  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://internet.lpu.in/*",
    "https://10.10.0.1/*",
    "https://ums.lpu.in/*",
    "https://myaccountinternet.lpu.in/*",
    "https://lpulive.lpu.in/*",
    "https://myclass.lpu.in/*",
    "https://myexam.lpu.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LPU Internet Auto-Login",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://internet.lpu.in/*",
        "https://10.10.0.1/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://ums.lpu.in/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://myexam.lpu.in/*",
        "https://myclass.lpu.in/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://myaccountinternet.lpu.in/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://lpulive.lpu.in/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ]
}
